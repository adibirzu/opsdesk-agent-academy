%% OCI diagram: node aliases and oci-service metadata are recorded in comments
flowchart LR
  subgraph G1["OCI workload"]
    %% oci-node: n1 = browser (oci-service: custom)
    n1["Browser chat Text and selected alias"]
    %% oci-node: n2 = harness (oci-service: custom)
    n2["Local harness Session, policy, budgets"]
    %% oci-node: n3 = llm (oci-service: custom)
    n3["Participant LLM Real streamed replies"]
    %% oci-node: n4 = validator (oci-service: custom)
    n4["Tool validator Allowlist + JSON schema"]
    %% oci-node: n5 = handlers (oci-service: custom)
    n5["Read-only handlers Synthetic training data"]
    %% oci-node: n6 = observer (oci-service: custom)
    n6["Metadata Observer No prompts or keys"]
    %% oci-node: n7 = files (oci-service: custom)
    n7["Private evidence Events + receipts"]
    %% oci-node: n8 = langfuse (oci-service: custom)
    n8["Optional Langfuse Own project + readback"]
  end
  n1 -->|"request"| n2
  n2 -.->|"bounded call"| n3
  n3 -->|"tool proposal"| n4
  n4 -.->|"validated only"| n5
  n5 -.->|"tool observation"| n3
  n2 -.->|"trace context"| n6
  n4 -.->|"tool decisions"| n6
  n6 -.->|"local records"| n7
  n6 -.->|"explicit export"| n8
  classDef oci fill:#FFF3E0,stroke:#C74634,color:#312D2A,stroke-width:2px;
  class n1,n2,n3,n4,n5,n6,n7,n8 oci;
