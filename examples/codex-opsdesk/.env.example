# Server secrets only. Create private values in your own approved runtime.
WORKSHOP_LOGIN_SECRET=<GENERATE_A_PRIVATE_RANDOM_VALUE_OF_AT_LEAST_32_CHARACTERS>
SESSION_SIGNING_SECRET=<GENERATE_A_DIFFERENT_PRIVATE_RANDOM_VALUE_OF_AT_LEAST_32_CHARACTERS>
PUBLIC_ORIGIN=https://<YOUR_EXACT_DEPLOYMENT_HOST>
AI_GATEWAY_API_KEY=<YOUR_APPROVED_VERCEL_AI_GATEWAY_KEY>
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=<YOUR_PROJECT_PUBLIC_KEY>
LANGFUSE_SECRET_KEY=<YOUR_PROJECT_INGESTION_SECRET>
UPSTASH_REDIS_REST_URL=https://<YOUR_OWNED_DATABASE>.upstash.io
UPSTASH_REDIS_REST_TOKEN=<YOUR_DATABASE_REST_TOKEN>
QUOTA_NAMESPACE=<UNIQUE_WORKSHOP_PROJECT_LABEL>
# Local rehearsal only: never used as a deployed/serverless quota fallback.
LOCAL_SINGLE_PROCESS_QUOTA=0
